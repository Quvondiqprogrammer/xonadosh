DirectoryIndex index.html index.php
# XonaDosh — Apache shared hosting

Options -Indexes -MultiViews
FileETag MTime Size

<FilesMatch "^(config\.local\.php|config\.example\.php|\.env.*|\.git.*|.*\.sql|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API v1 versioning aliases
  RewriteRule ^api/v1/([^/]+)\.php$ api/$1.php [L,QSA]
  RewriteRule ^api/v1/([^/]+)$ api/$1.php [L,QSA]

  RewriteRule ^join/([^/]+)/?$ join.php?code=$1 [L,QSA]
  RewriteRule ^uylar/([^/]+)/?$ uylar/index.php?slug=$1 [L,QSA]
  RewriteRule ^uylar/?$ uylar/index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>
